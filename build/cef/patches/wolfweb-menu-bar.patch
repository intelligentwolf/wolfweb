+namespace {
+
+// The row's height and each title's side padding, in DIPs.
+constexpr int kMenuBarHeight = 28;
+constexpr int kTitlePadding = 8;
+// Space either side of the wolf logo at the start of the row.
+constexpr int kLogoLeadingPadding = 10;
+constexpr int kLogoTrailingPadding = 4;
+
+// Ids for items that open a page rather than run a Chrome command; above every
+// IDC_ value (chrome/app/chrome_command_ids.h).
+constexpr int kFirstUrlCommand = 900000;
+
+// WolfWeb's built-in extension (its fixed key in WolfWeb's
+// extension/manifest.json; src/extension.rs ID).
+constexpr char kWolfWebPages[] =
+    "chrome-extension://fhmfanjkjkjnbognbfdiegdineklmkjm/";
+
+}  // namespace
+
+struct WolfWebMenuBar::Menu {
+  std::unique_ptr<ui::SimpleMenuModel> model;
+  raw_ptr<views::MenuButton> button = nullptr;
+  std::unique_ptr<views::MenuButtonController::PressedLock> pressed_lock;
+};
+
+WolfWebMenuBar::WolfWebMenuBar(BrowserView* browser_view)
+    : browser_view_(browser_view) {
+  auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+
+  // The wolf at the start of the row. IDR_PRODUCT_LOGO_16 is the product logo
+  // at 16 DIPs (chrome/app/theme/theme_resources.grd), which WolfWeb replaces
+  // with its wolf at run time (src/branding.rs), loaded the way
+  // tab_icon_view.cc loads it. Decorative: the row's window title says
+  // WolfWeb, so screen readers skip it, and it drags the window like the rest
+  // of the row (IsPositionInWindowCaption).
+  auto logo = std::make_unique<views::ImageView>(ui::ImageModel::FromImageSkia(
+      *ui::ResourceBundle::GetSharedInstance().GetImageSkiaNamed(
+          IDR_PRODUCT_LOGO_16)));
+  logo->SetBorder(views::CreateEmptyBorder(
+      gfx::Insets::TLBR(0, kLogoLeadingPadding, 0, kLogoTrailingPadding)));
+  logo->GetViewAccessibility().SetIsIgnored(true);
+  logo_ = AddChildView(std::move(logo));
+
+  BuildMenus();
+
+  pref_registrar_.Init(browser_view_->browser()->GetProfile()->GetPrefs());
+  pref_registrar_.Add(kPrefName,
+                      base::BindRepeating(&WolfWebMenuBar::OnPrefChanged,
+                                          base::Unretained(this)));
+}
+
+WolfWebMenuBar::~WolfWebMenuBar() = default;
+
+void WolfWebMenuBar::BuildMenus() {
+  // One menu: its title, then items. An item is a Chrome command (IDC_*), a
+  // WolfWeb page or a web address; a null title is a separator.
+  struct Item {
+    const char16_t* title;
+    int command = 0;
+    const char* url = nullptr;  // a WolfWeb page if it has no scheme
+  };
+  struct MenuSpec {
+    const char16_t* title;
+    std::vector<Item> items;
+  };
+  // The same menus as WolfWeb's bookmarks-bar menus (extension/menubar.js).
+  const std::vector<MenuSpec> specs = {
+      {u"File",
+       {{u"New tab", IDC_NEW_TAB},
+        {u"New window", IDC_NEW_WINDOW},
+        {u"New private window", IDC_NEW_INCOGNITO_WINDOW},
+        {nullptr},
+        {u"Open file…", IDC_OPEN_FILE},
+        {u"Save page as…", IDC_SAVE_PAGE},
+        {u"Print…", IDC_PRINT},
+        {nullptr},
+        {u"Close tab", IDC_CLOSE_TAB},
+        {u"Close window", IDC_CLOSE_WINDOW},
+        {nullptr},
+        {u"Quit WolfWeb", IDC_EXIT}}},
+      {u"Edit",
+       {{u"Cut", IDC_CUT},
+        {u"Copy", IDC_COPY},
+        {u"Paste", IDC_PASTE},
+        {nullptr},
+        {u"Find…", IDC_FIND}}},
+      {u"View",
+       {{u"Zoom in", IDC_ZOOM_PLUS},
+        {u"Zoom out", IDC_ZOOM_MINUS},
+        {u"Actual size", IDC_ZOOM_NORMAL},
+        {nullptr},
+        {u"Full screen", IDC_FULLSCREEN},
+        {u"Vertical tabs on/off", IDC_TOGGLE_VERTICAL_TABS},
+        {u"Split view (tile tabs)", IDC_NEW_SPLIT_TAB},
+        {nullptr},
+        {u"Reload", IDC_RELOAD},
+        {u"View page source", IDC_VIEW_SOURCE}}},
+      {u"Bookmarks",
+       {{u"Bookmark this tab", IDC_BOOKMARK_THIS_TAB},
+        {u"Bookmark manager", IDC_SHOW_BOOKMARK_MANAGER},
+        {nullptr},
+        {u"Bring your bookmarks from another browser", 0, "import.html"}}},
+      {u"Tools",
+       {{u"Your newspaper", 0, "daily.html"},
+        {u"Downloads", IDC_SHOW_DOWNLOADS},
+        {u"History", IDC_SHOW_HISTORY},
+        {u"Passwords", IDC_SHOW_PASSWORD_MANAGER},
+        {nullptr},
+        {u"Extensions", IDC_MANAGE_EXTENSIONS},
+        {u"Get extensions (Chrome Web Store)", 0,
+         "https://chromewebstore.google.com/category/extensions"},
+        {u"Command chains", 0, "chains.html"},
+        {nullptr},
+        {u"Task manager", IDC_TASK_MANAGER},
+        {u"Developer tools", IDC_DEV_TOOLS},
+        {u"Clear browsing data…", IDC_CLEAR_BROWSING_DATA},
+        {nullptr},
+        {u"WolfWeb settings", 0, "settings.html"},
+        {u"All settings", IDC_OPTIONS}}},
+      {u"Window",
+       {{u"Next tab", IDC_SELECT_NEXT_TAB},
+        {u"Previous tab", IDC_SELECT_PREVIOUS_TAB},
+        {u"Duplicate tab", IDC_DUPLICATE_TAB},
+        {u"Pin or unpin tab", IDC_PIN_TARGET_TAB},
+        {u"Reopen closed tab", IDC_RESTORE_TAB},
+        {u"Search open tabs", IDC_TAB_SEARCH}}},
+      {u"Help",
+       {{u"WolfWeb on GitHub", 0, "https://github.com/intelligentwolf/wolfweb"},
+        {u"Get WolfMail", 0,
+         "https://github.com/intelligentwolf/wolfmail/releases"},
+        {u"Sponsor WolfWeb", 0, "https://github.com/sponsors/intelligentwolf"},
+        {nullptr},
+        {u"About WolfWeb", IDC_ABOUT}}},
+  };
+
+  for (size_t i = 0; i < specs.size(); ++i) {
+    auto menu = std::make_unique<Menu>();
+    menu->model = std::make_unique<ui::SimpleMenuModel>(this);
+    for (const Item& item : specs[i].items) {
+      if (!item.title) {
+        menu->model->AddSeparator(ui::NORMAL_SEPARATOR);
+      } else if (item.url) {
+        const std::string url(item.url);
+        urls_.push_back(url.find("://") == std::string::npos
+                            ? std::string(kWolfWebPages) + url
+                            : url);
+        menu->model->AddItem(
+            kFirstUrlCommand + static_cast<int>(urls_.size()) - 1, item.title);
+      } else {
+        menu->model->AddItem(item.command, item.title);
+      }
+    }
+    auto button = std::make_unique<views::MenuButton>(
+        base::BindRepeating(&WolfWebMenuBar::ShowMenu, base::Unretained(this),
+                            i),
+        specs[i].title);
+    button->SetBorder(views::CreateEmptyBorder(
+        gfx::Insets::VH(0, kTitlePadding)));
+    button->SetEnabledTextColors(kColorTabForegroundInactiveFrameActive);
+    menu->button = AddChildView(std::move(button));
+    menus_.push_back(std::move(menu));
+  }
+}
+
+void WolfWebMenuBar::ShowMenu(size_t index) {
+  Menu& menu = *menus_[index];
+  menu.pressed_lock = menu.button->button_controller()->TakeLock();
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu.model.get(), views::MenuRunner::NO_FLAGS,
+      base::BindRepeating(
+          [](WolfWebMenuBar* bar, size_t i) {
+            bar->menus_[i]->pressed_lock.reset();
+          },
+          base::Unretained(this), index));
+  menu_runner_->RunMenuAt(GetWidget(), menu.button->button_controller(),
+                          menu.button->GetBoundsInScreen(),
+                          views::MenuAnchorPosition::kTopLeft,
+                          ui::mojom::MenuSourceType::kNone);
+  if (!menu_runner_->IsRunning()) {
+    menu.pressed_lock.reset();
+  }
+}
+
+bool WolfWebMenuBar::IsWanted() const {
+  return browser_view_->browser()->GetProfile()->GetPrefs()->GetBoolean(
+      kPrefName);
+}
+
+void WolfWebMenuBar::OnPrefChanged() {
+  PreferredSizeChanged();
+  browser_view_->InvalidateLayout();
+}
+
+gfx::Size WolfWebMenuBar::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  // Zero height when switched off: the layout then gives the row no space.
+  if (!IsWanted()) {
+    return gfx::Size();
+  }
+  int width = logo_->GetPreferredSize().width();
+  for (const auto& menu : menus_) {
+    width += menu->button->GetPreferredSize().width();
+  }
+  return gfx::Size(width, kMenuBarHeight);
+}
+
+bool WolfWebMenuBar::IsPositionInWindowCaption(const gfx::Point& point) {
+  for (const auto& menu : menus_) {
+    gfx::Point in_button = point;
+    views::View::ConvertPointToTarget(this, menu->button, &in_button);
+    if (menu->button->HitTestPoint(in_button)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool WolfWebMenuBar::IsCommandIdEnabled(int command_id) const {
+  if (command_id >= kFirstUrlCommand) {
+    return true;
+  }
+  return chrome::IsCommandEnabled(browser_view_->browser(), command_id);
+}
+
+bool WolfWebMenuBar::GetAcceleratorForCommandId(
+    int command_id,
+    ui::Accelerator* accelerator) const {
+  if (command_id >= kFirstUrlCommand) {
+    return false;
+  }
+  return browser_view_->GetAccelerator(command_id, accelerator);
+}
+
+void WolfWebMenuBar::ExecuteCommand(int command_id, int event_flags) {
+  if (command_id >= kFirstUrlCommand) {
+    const size_t index = static_cast<size_t>(command_id - kFirstUrlCommand);
+    if (index < urls_.size()) {
+      OpenUrl(GURL(urls_[index]));
+    }
+    return;
+  }
+  chrome::ExecuteCommand(browser_view_->browser(), command_id);
+}
+
+void WolfWebMenuBar::OpenUrl(const GURL& url) {
+  ShowSingletonTabOverwritingNTP(browser_view_->browser(), url);
+}
+
+BEGIN_METADATA(WolfWebMenuBar)
+END_METADATA

+// WolfWeb's menu bar: the wolf logo, then File, Edit, View, Bookmarks, Tools,
+// Window and Help as plain text menus, along the very top of a normal browser
+// window, above the tab strip (BrowserViewTabbedLayoutImpl reserves the row).
+// The items run Chrome's own commands (chrome::ExecuteCommand) or open
+// WolfWeb's pages.
+// Shown while the "wolfweb.menu_bar" profile pref is true; not built on macOS,
+// which has the system menu bar.
+class WolfWebMenuBar : public views::View,
+                       public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(WolfWebMenuBar, views::View)
+
+ public:
+  // The profile pref that shows or hides the menu bar (registered, under the
+  // same name, by RegisterBrowserUserPrefs in browser_ui_prefs.cc; WolfWeb's
+  // settings page sets it).
+  static constexpr char kPrefName[] = "wolfweb.menu_bar";
+
+  explicit WolfWebMenuBar(BrowserView* browser_view);
+  WolfWebMenuBar(const WolfWebMenuBar&) = delete;
+  WolfWebMenuBar& operator=(const WolfWebMenuBar&) = delete;
+  ~WolfWebMenuBar() override;
+
+  // True where the window can be dragged: anywhere in the row except the menu
+  // titles themselves. `point` is in this view's coordinates.
+  bool IsPositionInWindowCaption(const gfx::Point& point);
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdEnabled(int command_id) const override;
+  bool GetAcceleratorForCommandId(int command_id,
+                                  ui::Accelerator* accelerator) const override;
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  struct Menu;
+
+  void BuildMenus();
+  void ShowMenu(size_t index);
+  void OnPrefChanged();
+  bool IsWanted() const;
+  void OpenUrl(const GURL& url);
+
+  raw_ptr<BrowserView> browser_view_;
+  raw_ptr<views::ImageView> logo_ = nullptr;
+  std::vector<std::unique_ptr<Menu>> menus_;
+  // Our own command ids (pages and web links) and where they go.
+  std::vector<std::string> urls_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+  PrefChangeRegistrar pref_registrar_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_WOLFWEB_MENU_BAR_H_

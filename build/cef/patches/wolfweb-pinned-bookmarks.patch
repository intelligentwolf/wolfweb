+      !params->url.SchemeIs(url::kJavaScriptScheme) &&
+      params->url != params->source_contents->GetLastCommittedURL()) {
+    TabStripModel* const tabs = params->browser->GetTabStripModel();
+    const int index = tabs->GetIndexOfWebContents(params->source_contents);
+    if (index != TabStripModel::kNoTab && tabs->IsTabPinned(index)) {
+      params->disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    }
+  }
 

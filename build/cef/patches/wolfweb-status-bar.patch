+  // it. Not in fullscreen (that includes a video played fullscreen). Insetting
+  // only the bottom leaves the frame-control exclusion areas as they are
+  // (BrowserLayoutParams::Inset shrinks them by the left/right and top insets).
+  // Whether it's shown is its preferred height (zero when switched off), not
+  // GetVisible(): the layout itself hides it in fullscreen (AddChild's
+  // visibility), so after fullscreen GetVisible() would keep it hidden.
+  if (IsParentedTo(views().wolfweb_status_bar, views().browser_view)) {

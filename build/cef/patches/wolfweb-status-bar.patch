diff -ruN a/chrome/browser/ui/views/frame/wolfweb_status_bar.cc b/chrome/browser/ui/views/frame/wolfweb_status_bar.cc
--- a/chrome/browser/ui/views/frame/wolfweb_status_bar.cc	1970-01-01 01:00:00.000000000 +0100
+++ b/chrome/browser/ui/views/frame/wolfweb_status_bar.cc	2026-11-04 09:31:54.946865418 +0000
@@ -0,0 +1,69 @@
+// Copyright 2026 IntelligentWolf Ltd. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/wolfweb_status_bar.h"
+
+#include "base/functional/bind.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "components/prefs/pref_service.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/gfx/geometry/size.h"
+#include "url/gurl.h"
+
+namespace {
+
+// WolfWeb's built-in extension (its manifest key fixes the id).
+constexpr char kStripUrl[] =
+    "chrome-extension://fhmfanjkjkjnbognbfdiegdineklmkjm/statusstrip.html";
+
+}  // namespace
+
+WolfWebStatusBar::WolfWebStatusBar(BrowserView* browser_view)
+    : views::WebView(browser_view->browser()->GetProfile()),
+      browser_view_(browser_view) {
+  SetVisible(IsWanted());
+  pref_registrar_.Init(browser_view_->browser()->GetProfile()->GetPrefs());
+  pref_registrar_.Add(kPrefName,
+                      base::BindRepeating(&WolfWebStatusBar::OnPrefChanged,
+                                          base::Unretained(this)));
+}
+
+WolfWebStatusBar::~WolfWebStatusBar() = default;
+
+bool WolfWebStatusBar::IsWanted() const {
+  return browser_view_->browser()->GetProfile()->GetPrefs()->GetBoolean(
+      kPrefName);
+}
+
+void WolfWebStatusBar::OnPrefChanged() {
+  SetVisible(IsWanted());
+  PreferredSizeChanged();
+  browser_view_->InvalidateLayout();
+}
+
+gfx::Size WolfWebStatusBar::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  // Zero height when switched off: the layout then gives it no space.
+  return IsWanted() ? gfx::Size(0, kHeight) : gfx::Size();
+}
+
+void WolfWebStatusBar::AddedToWidget() {
+  views::WebView::AddedToWidget();
+  if (loaded_) {
+    return;
+  }
+  loaded_ = true;
+  // The extension's id for this window is the browser's session id
+  // (BrowserExtensionWindowController::GetWindowId).
+  LoadInitialURL(GURL(base::StrCat(
+      {kStripUrl, "?window=",
+       base::NumberToString(browser_view_->browser()->GetSessionID().id())})));
+}
+
+BEGIN_METADATA(WolfWebStatusBar)
+END_METADATA

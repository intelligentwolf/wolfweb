@@ -0,0 +1,49 @@
+// Copyright 2026 IntelligentWolf Ltd. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_WOLFWEB_STATUS_BAR_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_WOLFWEB_STATUS_BAR_H_
+
+#include "base/memory/raw_ptr.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/controls/webview/webview.h"
+
+class BrowserView;
+
+// WolfWeb's status bar: a strip along the bottom of a normal window, below the
+// page (which is made that much shorter), with the active tab's load time,
+// reading time and zoom, and the time. The strip shows a page of WolfWeb's
+// built-in extension (statusstrip.html), told its window's id so it can follow
+// that window's active tab with the tabs API. Hidden in fullscreen
+// (BrowserViewTabbedLayoutImpl::DoPreLayoutComputations) and when switched off
+// in WolfWeb's settings (kPrefName).
+class WolfWebStatusBar : public views::WebView {
+  METADATA_HEADER(WolfWebStatusBar, views::WebView)
+
+ public:
+  // On or off; registered in chrome/browser/ui/browser_ui_prefs.cc.
+  static constexpr char kPrefName[] = "wolfweb.status_bar";
+  static constexpr int kHeight = 26;
+
+  explicit WolfWebStatusBar(BrowserView* browser_view);
+  WolfWebStatusBar(const WolfWebStatusBar&) = delete;
+  WolfWebStatusBar& operator=(const WolfWebStatusBar&) = delete;
+  ~WolfWebStatusBar() override;
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void AddedToWidget() override;
+
+ private:
+  bool IsWanted() const;
+  void OnPrefChanged();
+
+  raw_ptr<BrowserView> browser_view_;
+  PrefChangeRegistrar pref_registrar_;
+  bool loaded_ = false;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_WOLFWEB_STATUS_BAR_H_

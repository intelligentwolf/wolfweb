+                 revised.visual_client_area.height());
+    if (!fullscreen && height > 0) {
+      const gfx::Rect& area = revised.visual_client_area;
+      layout_data_->wolfweb_status_bar_bounds = gfx::Rect(
+          area.x(), area.bottom() - height, area.width(), height);
+      revised.Inset(gfx::Insets::TLBR(0, 0, height, 0));
